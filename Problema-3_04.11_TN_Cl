import random
MAX = 200

X = set(random.sample(range(0, MAX), random.randint(0, MAX)))
Y = set(random.sample(range(0, MAX), random.randint(0, MAX)))
Z = set(random.sample(range(0, MAX), random.randint(0, MAX)))

print("X =", X)
print("Y =", Y)
print("Z =", Z)

X_neg = {i for i in range(0, MAX) if i not in X}
Y_neg = {i for i in range(0, MAX) if i not in Y}
Z_neg = {i for i in range(0, MAX) if i not in Z}

if (set(range(0, MAX)) - (X | Y | Z)) == (X_neg & Y_neg & Z_neg):
    print("Legea 1 este adevarata")
else:
    print("Legea 1 este falsa")

if (set(range(0, MAX)) - (X & Y & Z)) == (X_neg | Y_neg | Z_neg):
    print("Legea 2 este adevarata")
else:
    print("Legea 2 este falsa")
