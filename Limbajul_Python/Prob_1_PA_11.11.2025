elevi = (
    ("Popescu", "Ion", "M", (8.5, 9.0, 7.5)),
    ("Ionescu", "Maria", "F", (9.5, 9.0, 9.2)),
    ("Vasilescu", "Ana", "F", (4.0, 6.0, 5.5)),
    ("Georgescu", "Alex", "M", (10.0, 10.0, 10.0)),
    ("Matei", "Cristina", "F", (8.0, 7.0, 6.5))
)

print("\nMedia fiecărui elev")
for e in elevi:
    medie = sum(e[3]) / 3
    print(e[0], e[1], "-> media:", round(medie,2))

print("\nElevi restanțieri")
for e in elevi:
    if min(e[3]) < 5:
        print(e[0], e[1])

print("\nElevi eminenți")
for e in elevi:
    medie = sum(e[3]) / 3
    if medie >= 9 and min(e[3]) >= 9:
        print(e[0], e[1])
