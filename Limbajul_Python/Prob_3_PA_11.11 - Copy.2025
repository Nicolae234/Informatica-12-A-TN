pers =(
    ("Ion Popescu",       19, 172, 68,  "M", "nu"),
    ("Mihai Ionescu",     25, 180, 85,  "M", "da"),
    ("Ana Georgescu",     30, 165, 60,  "F", "nu"),
    ("Maria Tudor",       22, 171, 70,  "F", "nu"),
    ("Elena Matei",       17, 160, 55,  "F", "nu"),
    ("Alex Vasilescu",    45, 175, 90,  "M", "da"),
    ("Cristina Balan",    28, 168, 62,  "F", "da"),
    ("Vlad Petrescu",     35, 182, 95,  "M", "nu"),
    ("Sorin Enache",      50, 178, 88,  "M", "da")
)

n = len(pers)

sub20 = 0
peste170 = 0
peste18_masa = []
femei = []
femei_nevoie = 0
total_masa = 0
grup_20_50 = []

for p in pers:
    nume = p[0]
    varsta = p[1]
    inaltime = p[2]
    masa = p[3]
    gen = p[4].lower()
    cas = p[5].lower()

    total_masa += masa

    if varsta < 20:
        sub20 += 1

    if inaltime > 170:
        peste170 += 1

    if varsta > 18:
        peste18_masa.append(masa)

    if gen == "f":
        femei.append(p)
        if varsta > 20 and cas == "nu":
            femei_nevoie += 1

    if 20 <= varsta <= 50:
        grup_20_50.append(p)

pct_sub20 = sub20 / n * 100
pct_peste170 = peste170 / n * 100

if peste18_masa:
    masa_medie_peste18 = sum(peste18_masa) / len(peste18_masa)
else:
    masa_medie_peste18 = 0

if femei:
    pct_femei = femei_nevoie / len(femei) * 100
else:
    pct_femei = 0

greutate_medie = total_masa / n

if grup_20_50:
    nr = 0
    for p in grup_20_50:
        if p[3] > greutate_medie:
            nr += 1
    pct_20_50 = nr / len(grup_20_50) * 100
else:
    pct_20_50 = 0

print("Procent persoane sub 20 ani:", pct_sub20, "%")
print("Procent persoane >170 cm:", pct_peste170, "%")
print("Masa medie persoane >18 ani:", masa_medie_peste18)
print("Procent femei >20 ani necasatorite:", pct_femei, "%")
print("Procent persoane 20-50 ani peste greutatea medie:", pct_20_50, "%")
