data_curenta = (9, 11, "Duminica")

zi_curenta = data_curenta[0]
luna_curenta = data_curenta[1]
denumire_zi_curenta = data_curenta[2]

zi_1_ian = "Luni" 

zile_luna = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
denumiri = ["Luni", "Marti", "Miercuri", "Joi", "Vineri", "Sambata", "Duminica"]

index_zi = denumiri.index(zi_1_ian)

contor = 0

for luna in range(luna_curenta - 1):
    for zi in range(1, zile_luna[luna] + 1):
        if denumiri[index_zi] == denumire_zi_curenta:
            contor += 1
        index_zi = (index_zi + 1) % 7

for zi in range(1, zi_curenta + 1):
    if denumiri[index_zi] == denumire_zi_curenta:
        contor += 1
    index_zi = (index_zi + 1) % 7

print("Numarul de zile", denumire_zi_curenta, "de la inceputul anului este:", contor)
